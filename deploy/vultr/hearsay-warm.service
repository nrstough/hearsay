[Unit]
Description=HEARSAY API warm-up (load the models, score one demo clip)
After=hearsay-api.service
Requires=hearsay-api.service
PartOf=hearsay-api.service

[Service]
Type=oneshot
User=hearsay
Group=hearsay
WorkingDirectory=/home/hearsay/hearsay
ExecStart=/bin/bash deploy/vultr/warm.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
